<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Vanilla Brewing Expanded -->
  <Operation Class="PatchOperationReplace" MayRequire="VanillaExpanded.VBrewE">
    <xpath>Defs/ThingDef[defName="VBE_Plant_Coffee"]/plant/sowTags</xpath>
    <value>
      <sowTags />
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="VanillaExpanded.VBrewE">
    <xpath>Defs/ThingDef[defName="VBE_Plant_Tea"]/plant/sowTags</xpath>
    <value>
      <sowTags />
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="VanillaExpanded.VBrewE">
    <xpath>Defs/ThingDef[defName="VBE_Plant_Tobacco"]/plant/sowTags</xpath>
    <value>
      <sowTags />
    </value>
  </Operation>

  <!-- Vanilla Factions Expanded - Settlers -->
  <Operation Class="PatchOperationReplace" MayRequire="OskarPotocki.VanillaFactionsExpanded.SettlersModule">
    <xpath>Defs/ThingDef[defName="Plant_Chemroot"]/plant/sowTags</xpath>
    <value>
      <sowTags />
    </value>
  </Operation>

  <!-- Vanilla Factions Expanded - Medieval 2 (makes these sowable + harvestable for alchemy) -->
  <Operation Class="PatchOperationReplace" MayRequire="OskarPotocki.VFE.Medieval2">
    <xpath>Defs/ThingDef[defName="Plant_Astragalus"]/plant/sowTags</xpath>
    <value>
      <sowTags />
    </value>
  </Operation>

  <Operation Class="PatchOperationRemove" MayRequire="OskarPotocki.VFE.Medieval2">
    <xpath>Defs/ThingDef[defName="Plant_Astragalus"]/plant/sowResearchPrerequisites</xpath>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="OskarPotocki.VFE.Medieval2">
    <xpath>Defs/ThingDef[defName="VFEM2_AstragalusFlowers"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False" />
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="OskarPotocki.VFE.Medieval2">
    <xpath>Defs/ThingDef[defName="Plant_Rafflesia"]/plant/sowTags</xpath>
    <value>
      <sowTags />
    </value>
  </Operation>

  <Operation Class="PatchOperationRemove" MayRequire="OskarPotocki.VFE.Medieval2">
    <xpath>Defs/ThingDef[defName="Plant_Rafflesia"]/plant/sowResearchPrerequisites</xpath>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="OskarPotocki.VFE.Medieval2">
    <xpath>Defs/ThingDef[defName="VFEM2_RafflesiaLeaves"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False" />
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="OskarPotocki.VFE.Medieval2">
    <xpath>Defs/ThingDef[defName="Plant_Clivia"]/plant/sowTags</xpath>
    <value>
      <sowTags />
    </value>
  </Operation>

  <Operation Class="PatchOperationRemove" MayRequire="OskarPotocki.VFE.Medieval2">
    <xpath>Defs/ThingDef[defName="Plant_Clivia"]/plant/sowResearchPrerequisites</xpath>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="OskarPotocki.VFE.Medieval2">
    <xpath>Defs/ThingDef[defName="VFEM2_CliviaPetals"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False" />
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="OskarPotocki.VFE.Medieval2">
    <xpath>Defs/ThingDef[defName="Plant_Alocasia"]/plant/sowTags</xpath>
    <value>
      <sowTags />
    </value>
  </Operation>

  <Operation Class="PatchOperationRemove" MayRequire="OskarPotocki.VFE.Medieval2">
    <xpath>Defs/ThingDef[defName="Plant_Alocasia"]/plant/sowResearchPrerequisites</xpath>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="OskarPotocki.VFE.Medieval2">
    <xpath>Defs/ThingDef[defName="VFEM2_AlocasiaLeaves"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False" />
    </value>
  </Operation>

  <!-- Prevent wild spawning in biomes -->
  <Operation Class="PatchOperationRemove" MayRequire="OskarPotocki.VFE.Medieval2">
    <xpath>Defs/BiomeDef/wildPlants/Plant_Astragalus</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove" MayRequire="OskarPotocki.VFE.Medieval2">
    <xpath>Defs/BiomeDef/wildPlants/Plant_Rafflesia</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove" MayRequire="OskarPotocki.VFE.Medieval2">
    <xpath>Defs/BiomeDef/wildPlants/Plant_Clivia</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove" MayRequire="OskarPotocki.VFE.Medieval2">
    <xpath>Defs/BiomeDef/wildPlants/Plant_Alocasia</xpath>
  </Operation>

  <!-- Vanilla Landmarks Expanded -->
  <Operation Class="PatchOperationReplace" MayRequire="VanillaExpanded.VExplorationE">
    <xpath>Defs/ThingDef[defName="VEE_AnimaPearls"]/thingCategories</xpath>
    <value>
      <thingCategories Inherit="False" />
    </value>
  </Operation>
</Patch>
